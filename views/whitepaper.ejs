  @media print {
    body {
      background: #ffffff !important;
      color: #000000 !important;
    }

    .site-header,
    .site-footer,
    .wp-sidebar,
    .wp-progress,
    .wp-top,
    .wp-download,
    .wp-meta { display: none !important; }

    .wp-layout {
      display: block !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .wp-main { max-width: 100% !important; }

    .wp-page {
      page-break-after: always;
      border-bottom: 0 !important;
      padding: 30px 0 !important;
    }

    .wp-page:last-of-type { page-break-after: auto; }

    .wp-page h2,
    .wp-page h3,
    .wp-header h1 { color: #000000 !important; }

    .wp-page p,
    .wp-page li {
      color: #333333 !important;
      font-size: 12pt !important;
      line-height: 1.6 !important;
    }

    .wp-page-num,
    .wp-page h4,
    .wp-card-title,
    .wp-hindrance-label { color: #cc6a00 !important; }

    .wp-card,
    .wp-hindrance,
    .wp-quote {
      background: #f8f8f8 !important;
      border: 1px solid #dddddd !important;
      page-break-inside: avoid;
    }

    .wp-quote {
      border-left: 3px solid #cc6a00 !important;
      font-style: italic;
    }

    .wp-emoji-hero,
    .wp-emoji-row,
    .wp-card-emoji { filter: none !important; }

    a {
      color: #cc6a00 !important;
      text-decoration: underline;
    }

    .wp-alloc-row { border-bottom: 1px solid #e0e0e0 !important; }
    .wp-alloc-pct { color: #cc6a00 !important; }

    @page { margin: 20mm; }
  }
