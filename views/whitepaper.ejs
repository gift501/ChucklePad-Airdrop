  .wp-alloc-row:last-child { border-bottom: 0; }

  .wp-alloc-label {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wp-alloc-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .wp-alloc-pct {
    color: #ff8a00;
    font-weight: 900;
  }

  .wp-hindrance {
    padding: 24px;
    margin-bottom: 16px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    background: #0c0c10;
  }

  .wp-hindrance-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .wp-hindrance-emoji {
    font-size: 28px;
    line-height: 1;
  }

  .wp-hindrance-label {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: #ff8a00;
  }

  .wp-hindrance h3 {
    margin: 0 0 12px;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .wp-hindrance p {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: #a7a7b0;
  }

  .wp-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #ff8a00;
    color: #07070a;
    border: 0;
    font-size: 20px;
    font-weight: 900;
    cursor: pointer;
    display: none;
    z-index: 100;
    box-shadow: 0 10px 30px rgba(255,138,0,0.3);
  }

  .wp-top.show { display: block; }

  @media (max-width: 900px) {
    .wp-layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .wp-sidebar {
      position: relative;
      top: 0;
      max-height: none;
      border-right: 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 0 0 20px;
      margin-bottom: 20px;
    }

    .wp-cards { grid-template-columns: 1fr; }
