%>

<%- include("partials/header", { title }) %>

<style>
  .wp-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: #ff8a00;
    z-index: 9999;
    transition: width 0.1s linear;
  }

  .wp-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 60px;
    width: min(1400px, calc(100% - 40px));
    margin: 40px auto 100px;
  }

  .wp-sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
    padding-right: 20px;
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .wp-sidebar-title {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: #ff8a00;
    margin-bottom: 20px;
  }

  .wp-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .wp-nav li { margin-bottom: 4px; }

  .wp-nav a {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #a7a7b0;
    transition: 0.15s ease;
  }

  .wp-nav a:hover {
    color: #f5f5f5;
    background: rgba(255,255,255,0.04);
  }

  .wp-nav a.active {
    color: #ff8a00;
    background: rgba(255,138,0,0.08);
  }

  .wp-nav-num {
    color: #ff8a00;
    font-weight: 900;
    margin-right: 8px;
    opacity: 0.7;
  }

  .wp-main { max-width: 760px; }

  .wp-header {
    margin-bottom: 80px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .wp-header .eyebrow { margin-bottom: 20px; }

  .wp-header h1 {
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0 0 20px;
  }

  .wp-header h1 span { color: #ff8a00; }

  .wp-header .subtitle {
    font-size: 20px;
    color: #a7a7b0;
    line-height: 1.5;
    max-width: 560px;
  }

  .wp-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin-top: 30px;
    font-size: 13px;
    color: #777780;
  }

  .wp-meta strong {
    color: #f5f5f5;
    font-weight: 800;
  }

  .wp-download {
    display: inline-block;
    margin-top: 30px;
    padding: 12px 22px;
    border: 1px solid rgba(255,138,0,0.3);
    border-radius: 999px;
    background: transparent;
    color: #ff8a00;
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .wp-download:hover {
    background: rgba(255,138,0,0.08);
    border-color: #ff8a00;
  }

  .wp-page {
    padding: 60px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    scroll-margin-top: 100px;
  }

  .wp-page:last-of-type { border-bottom: 0; }

  .wp-page-num {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #ff8a00;
    margin-bottom: 20px;
  }

  .wp-page h2 {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 30px;
  }

  .wp-page h3 {
    font-size: 22px;
    margin: 40px 0 15px;
    letter-spacing: -0.02em;
  }

  .wp-page h4 {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #ff8a00;
    margin: 30px 0 10px;
  }

  .wp-page p {
    font-size: 17px;
    line-height: 1.75;
    color: #d8d8e0;
    margin: 0 0 20px;
  }

  .wp-page p strong {
    color: #f5f5f5;
    font-weight: 800;
  }

  .wp-page ul {
    padding-left: 22px;
    margin: 0 0 20px;
  }

  .wp-page li {
    font-size: 17px;
    line-height: 1.75;
    color: #d8d8e0;
    margin-bottom: 8px;
  }

  .wp-page a {
    color: #ff8a00;
    text-decoration: underline;
  }

  .wp-quote {
    margin: 40px 0;
    padding: 30px 35px;
    border-left: 3px solid #ff8a00;
    background: rgba(255,138,0,0.04);
    border-radius: 0 16px 16px 0;
