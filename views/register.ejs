<%- include("partials/header", { title }) %>

<section class="auth-section">

    <div class="auth-container">

        <div class="auth-heading">

            <span class="eyebrow">
                JOIN CHUCKLEPAD
            </span>

            <h1>
                Create your account.
            </h1>

            <p>
                Join the community, participate in activities,
                earn Points and build your ChucklePad journey.
            </p>

        </div>


        <% if (error) { %>

            <div class="form-error">
                <%= error %>
            </div>

        <% } %>


        <form
            method="POST"
            action="/register"
            class="auth-form"
            id="registerForm"
        >

            <div class="form-row">

                <div class="form-group">
                    <label for="first_name">First Name</label>
                    <input
                        type="text"
                        id="first_name"
                        name="first_name"
                        value="<%= form.first_name || '' %>"
                        autocomplete="given-name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="last_name">Last Name</label>
                    <input
                        type="text"
                        id="last_name"
                        name="last_name"
                        value="<%= form.last_name || '' %>"
                        autocomplete="family-name"
                        required
                    >
                </div>

            </div>


            <div class="form-group">

                <label for="username">Username</label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    value="<%= form.username || '' %>"
                    placeholder="e.g. chuckleking"
                    minlength="3"
                    maxlength="30"
                    pattern="[A-Za-z0-9_]+"
                    autocomplete="username"
                    required
                >

                <small>
                    3–30 characters. Letters, numbers and underscores only.
                </small>

            </div>


            <div class="form-group">

                <label for="countrySearch">Country</label>

                <div class="country-picker" id="countryPicker">

                    <input
                        type="text"
                        id="countrySearch"
                        class="country-search"
                        placeholder="Start typing... e.g. Nigeria"
                        autocomplete="off"
                        required
                    >

                    <input
                        type="hidden"
                        id="country"
                        name="country"
                        value="<%= form.country || '' %>"
                    >

                    <div
                        class="country-list"
                        id="countryList"
                        role="listbox"
                    ></div>

                </div>

                <small>
                    Type to filter. Click a country to select it.
                </small>

            </div>


            <div class="form-group">

                <label for="email">Email Address</label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= form.email || '' %>"
                    autocomplete="email"
                    required
                >

            </div>


            <div class="form-row">

                <div class="form-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="confirm_password">Confirm Password</label>
                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        minlength="8"
                        autocomplete="new-password"
                        required
                    >
                </div>

            </div>


            <div class="form-divider">
                <span>OPTIONAL</span>
            </div>


            <div class="form-group">

                <label for="referral_code">Referral Code</label>

                <input
                    type="text"
                    id="referral_code"
                    name="referral_code"
                    value="<%= form.referral_code || '' %>"
                    placeholder="Enter a friend's code"
                >

                <small>
                    If someone invited you, enter their referral code.
                </small>

            </div>


            <div class="form-group">

                <label for="genesis_code">Genesis Code</label>

                <input
                    type="text"
                    id="genesis_code"
                    name="genesis_code"
                    value="<%= form.genesis_code || '' %>"
                    placeholder="0000000"
                    maxlength="7"
                >

                <small>
                    Genesis Code: <strong>0000000</strong>.
                    The Genesis reward is limited to the first
                    1,000 eligible participants.
                </small>

            </div>


            <label class="checkbox-row">

                <input
                    type="checkbox"
                    name="terms"
                    required
                >

                <span>
                    I agree to the
                    <a href="/terms">Terms of Service</a>
                    and acknowledge the
                    <a href="/disclaimer">Disclaimer</a>.
                </span>

            </label>


            <button
                type="submit"
                class="button button-primary form-submit"
            >
                CREATE ACCOUNT
            </button>


            <p class="auth-switch">

                Already have an account?

                <a href="/login">Log in</a>

            </p>

        </form>

    </div>

</section>


<style>
  .country-picker { position: relative; }

  .country-search { width: 100%; }

  .country-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    max-height: 280px;
    overflow-y: auto;
    margin-top: 6px;
    padding: 6px 0;
    border: 1px solid #3a3a42;
    border-radius: 14px;
    background: #0c0c10;
    box-shadow: 6px 6px 0 #030304;
    display: none;
  }

  .country-list.open { display: block; }

  .country-option {
    padding: 11px 18px;
    cursor: pointer;
    font-size: 15px;
    color: #d8d8e0;
    transition: background 0.05s ease;
  }

  .country-option:hover,
  .country-option.active {
    background: #ff8a00;
    color: #07070a;
    font-weight: 800;
  }

  .country-empty {
    padding: 11px 18px;
    color: #777780;
    font-size: 14px;
    font-style: italic;
  }
</style>


<script>
(function () {

    const COUNTRIES = [
        "Afghanistan", "Albania", "Algeria", "Andorra", "Angola",
        "Antigua and Barbuda", "Argentina", "Armenia", "Australia", "Austria",
        "Azerbaijan", "Bahamas", "Bahrain", "Bangladesh", "Barbados",
        "Belarus", "Belgium", "Belize", "Benin", "Bhutan",
        "Bolivia", "Bosnia and Herzegovina", "Botswana", "Brazil", "Brunei",
        "Bulgaria", "Burkina Faso", "Burundi", "Cambodia", "Cameroon",
        "Canada", "Cape Verde", "Central African Republic", "Chad", "Chile",
        "China", "Colombia", "Comoros", "Congo", "Congo (DRC)",
        "Costa Rica", "Croatia", "Cuba", "Cyprus", "Czech Republic",
        "Denmark", "Djibouti", "Dominica", "Dominican Republic", "Ecuador",
        "Egypt", "El Salvador", "Equatorial Guinea", "Eritrea", "Estonia",
        "Eswatini", "Ethiopia", "Fiji", "Finland", "France",
        "Gabon", "Gambia", "Georgia", "Germany", "Ghana",
        "Greece", "Grenada", "Guatemala", "Guinea", "Guinea-Bissau",
        "Guyana", "Haiti", "Honduras", "Hungary", "Iceland",
        "India", "Indonesia", "Iran", "Iraq", "Ireland",
        "Israel", "Italy", "Ivory Coast", "Jamaica", "Japan",
        "Jordan", "Kazakhstan", "Kenya", "Kiribati", "Kosovo",
        "Kuwait", "Kyrgyzstan", "Laos", "Latvia", "Lebanon",
        "Lesotho", "Liberia", "Libya", "Liechtenstein", "Lithuania",
        "Luxembourg", "Madagascar", "Malawi", "Malaysia", "Maldives",
        "Mali", "Malta", "Marshall Islands", "Mauritania", "Mauritius",
        "Mexico", "Micronesia", "Moldova", "Monaco", "Mongolia",
        "Montenegro", "Morocco", "Mozambique", "Myanmar", "Namibia",
        "Nauru", "Nepal", "Netherlands", "New Zealand", "Nicaragua",
        "Niger", "Nigeria", "North Korea", "North Macedonia", "Norway",
        "Oman", "Pakistan", "Palau", "Palestine", "Panama",
        "Papua New Guinea", "Paraguay", "Peru", "Philippines", "Poland",
        "Portugal", "Qatar", "Romania", "Russia", "Rwanda",
        "Saint Kitts and Nevis", "Saint Lucia",
        "Saint Vincent and the Grenadines",
        "Samoa", "San Marino", "Sao Tome and Principe", "Saudi Arabia",
        "Senegal", "Serbia", "Seychelles", "Sierra Leone", "Singapore",
        "Slovakia", "Slovenia", "Solomon Islands", "Somalia",
        "South Africa", "South Korea", "South Sudan", "Spain",
        "Sri Lanka", "Sudan", "Suriname", "Sweden", "Switzerland",
        "Syria", "Taiwan", "Tajikistan", "Tanzania", "Thailand",
        "Timor-Leste", "Togo", "Tonga", "Trinidad and Tobago",
        "Tunisia", "Turkey", "Turkmenistan", "Tuvalu", "Uganda",
        "Ukraine", "United Arab Emirates", "United Kingdom",
        "United States", "Uruguay", "Uzbekistan", "Vanuatu",
        "Vatican City", "Venezuela", "Vietnam", "Yemen",
        "Zambia", "Zimbabwe"
    ];

    const search = document.getElementById("countrySearch");
    const hidden = document.getElementById("country");
    const list   = document.getElementById("countryList");
    const picker = document.getElementById("countryPicker");
    const form   = document.getElementById("registerForm");

    if (!search || !hidden || !list || !picker) return;

    let activeIndex = -1;
    let filtered = [];

    if (hidden.value) search.value = hidden.value;

    function render() {

        list.innerHTML = "";

        if (filtered.length === 0) {

            const empty = document.createElement("div");
            empty.className = "country-empty";
            empty.textContent = "No country matches that.";
            list.appendChild(empty);
            return;

        }

        filtered.forEach((country, index) => {

            const option = document.createElement("div");
            option.className = "country-option";
            option.textContent = country;
            option.setAttribute("role", "option");

            if (index === activeIndex) option.classList.add("active");

            option.addEventListener("mousedown", function (e) {
                e.preventDefault();
                select(country);
            });

            list.appendChild(option);

        });

    }

    function filterCountries(query) {

        const q = query.trim().toLowerCase();

        filtered = q === ""
            ? COUNTRIES.slice(0, 50)
            : COUNTRIES.filter((c) => c.toLowerCase().includes(q)).slice(0, 50);

        activeIndex = -1;
        render();

    }

    function select(country) {

        hidden.value = country;
        search.value = country;

        list.classList.remove("open");
        list.innerHTML = "";

    }

    function open() {
        list.classList.add("open");
        filterCountries(search.value);
    }

    function close() {
        list.classList.remove("open");
        activeIndex = -1;
    }

    function scrollActiveIntoView() {

        const active = list.querySelector(".country-option.active");

        if (active) active.scrollIntoView({ block: "nearest" });

    }

    search.addEventListener("focus", open);

    search.addEventListener("input", function () {
        hidden.value = "";
        open();
    });

    search.addEventListener("keydown", function (e) {

        if (!list.classList.contains("open")) {

            if (e.key === "ArrowDown") {
                open();
                e.preventDefault();
            }

            return;

        }

        if (e.key === "ArrowDown") {

            e.preventDefault();
            activeIndex = Math.min(activeIndex + 1, filtered.length - 1);
            render();
            scrollActiveIntoView();

        } else if (e.key === "ArrowUp") {

            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, 0);
            render();
            scrollActiveIntoView();

        } else if (e.key === "Enter") {

            if (activeIndex >= 0 && filtered[activeIndex]) {
                e.preventDefault();
                select(filtered[activeIndex]);
            }

        } else if (e.key === "Escape") {

            close();

        }

    });

    document.addEventListener("click", function (e) {

        if (!picker.contains(e.target)) close();

    });

    form.addEventListener("submit", function (e) {

        if (!hidden.value) {
            e.preventDefault();
            search.focus();
            alert("Please select your country from the list.");
            return;
        }

        const password = document.getElementById("password").value;
        const confirm  = document.getElementById("confirm_password").value;

        if (password !== confirm) {
            e.preventDefault();
            alert("Passwords do not match.");
        }

    });

})();
</script>


<%- include("partials/footer") %>