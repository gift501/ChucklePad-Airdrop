<%
  const title = "ChucklePad 😂 Laugh. Participate. Earn. Give Back.";

  const allocation = [
    { label: "Presale / Early Community", pct: 22,   color: "#ff8a00" },
    { label: "Liquidity",                 pct: 22,   color: "#ff6b00" },
    { label: "ChuckleScholar",            pct: 13,   color: "#ffb547" },
    { label: "ChuckleFeed",               pct: 10,   color: "#ffd166" },
    { label: "ChuckleCare",               pct: 8,    color: "#ff4d6d" },
    { label: "Community Airdrop",         pct: 7,    color: "#c77dff" },
    { label: "Treasury / Development",    pct: 7.5,  color: "#7bc4ff" },
    { label: "Staking & Rewards",         pct: 5,    color: "#4ade80" },
    { label: "NFT Holder Rewards",        pct: 3,    color: "#f472b6" },
    { label: "Base Network Community",    pct: 2,    color: "#22d3ee" },
    { label: "Marketing & Partnerships",  pct: 0.5,  color: "#a78bfa" }
  ];

  let cumulative = 0;
  const slices = allocation.map(({ label, pct, color }) => {
    const startAngle = (cumulative / 100) * 360;
    cumulative += pct;
    const endAngle = (cumulative / 100) * 360;

    const startRad = ((startAngle - 90) * Math.PI) / 180;
    const endRad   = ((endAngle   - 90) * Math.PI) / 180;

    const cx = 150, cy = 150, r = 130;

    const x1 = cx + r * Math.cos(startRad);
    const y1 = cy + r * Math.sin(startRad);
    const x2 = cx + r * Math.cos(endRad);
    const y2 = cy + r * Math.sin(endRad);

    const largeArc = endAngle - startAngle > 180 ? 1 : 0;

    const path = `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} Z`;

    return { label, pct, color, path };
  });
%>

