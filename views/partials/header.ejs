<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="ChucklePad — Laugh. Participate. Earn. Give Back."
  >

  <title><%= title || "ChucklePad" %></title>

  <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header class="site-header">

  <a href="/" class="brand">
    <span class="brand-name">CHUCKLEPAD</span>
    <span class="brand-token">$CPAD</span>
  </a>

  <button
    class="menu-toggle"
    id="menuToggle"
    type="button"
    aria-label="Open navigation"
  >
    ☰
  </button>

  <nav class="main-nav" id="mainNav">

    <a href="/">Home</a>

    <a href="/dashboard">Dashboard</a>

    <a href="/">Ecosystem</a>

    <a href="/">Roadmap</a>

    <a href="/whitepaper">White Paper</a>

    <% if (user) { %>

      <a href="/referrals" class="nav-referrals">Referrals</a>

      <form
        method="POST"
        action="/logout"
        class="nav-logout-form"
      >
        <button
          type="submit"
          class="nav-logout"
        >
          Logout
        </button>
      </form>

    <% } else { %>

      <a href="/login" class="nav-login">Login</a>

      <a href="/register" class="nav-join">
        Join ChucklePad
      <a href="/whitepaper" class="nav-join">
        Read White Paper
      </a>

    <% } %>

  </nav>

</header>

<main>